# ==============================================================================
# DepoSafe Environment Configuration Template
# ==============================================================================

# Application Environment ('development' or 'production')
# NOTE: In production, the backend will refuse to start if SECRET_KEY or
# BANK_SIGNING_KEY are left at their default insecure values.
ENVIRONMENT=development
PORT=8000

# Base directory for SQLite database and uploaded document storage
# - In local development: defaults to '.'
# - In container runtime: defaults to '/app/data_runtime'
# - On persistent disk: set to mount path e.g. '/data'
DATA_DIR=./data_runtime

# Database connection URL (defaults to sqlite:///${DATA_DIR}/deposafe.db)
# Optional PostgreSQL URL format: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./deposafe.db

# Storage directory for uploaded & generated PDFs (defaults to ${DATA_DIR}/storage)
STORAGE_DIR=./storage

# Cryptographic Keys (MUST BE CHANGED TO STRONG RANDOM VALUES IN PRODUCTION)
# JWT Secret Key for authenticating the 5 RBAC roles (System Admin, Verification Officer,
# Regional Officer, Competent Authority, Institution User)
SECRET_KEY=deposafe-super-secret-key-sih-2024-grand-finale-aicte-secure

# HMAC-SHA256 Secret Key for Core Banking Simulator signatures
BANK_SIGNING_KEY=deposafe-simulated-sfms-secret-key-2026

# Allowed CORS Origins (comma-separated, without trailing slashes)
# In production on Render, restrict this to your frontend service URL:
# e.g., https://deposafe-frontend.onrender.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Frontend Public API URL (consumed by frontend to contact backend)
# In production on Render, set to your backend service URL:
# e.g., https://deposafe-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
